---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search all content on Standing One for specific information about SI pain and related topics."
>
  <div class="content-wrapper">
    <h1>Search</h1>

    <p>Search all pages on this site for specific information, patterns, interventions, or concepts.</p>

    <div id="search"></div>
  </div>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        excerptLength: 30,
        autofocus: true
      });
    });
  </script>
</BaseLayout>
